# Server-side environment variables (Vercel project settings / .env.local).
# Never use a VITE_ prefix for secrets.

# Required for the "Explain this change" feature.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-3-flash-preview).
# If a model id is retired by Google, the endpoint automatically falls back
# to gemini-3-flash-preview and then gemini-3.1-flash-lite.
GEMINI_MODEL=

# NASA Earthdata bearer token for authenticated NISAR product retrieval
# (calibrated GCOV data via NASA Harmony).  Needed only by the Python
# processing pipeline (processing/serve.py and processing/nisar_change),
# read server-side from the environment or from this file's sibling
# .env.local (git-ignored).  Never expose it to the frontend or Git.
NASA_EARTHDATA_BEARER_TOKEN=your_token_here

# Optional (Python worker): cap for the analysis grid in pixels (default
# 6000000).  Larger areas are analysed on every k-th pixel (exact subsample,
# no smoothing); the result reports the factor and actual pixel size.
NISAR_MAX_ANALYSIS_PIXELS=

# Optional (client-side, build time): base URL of the analysis API when it is
# NOT served from the same origin (default: same origin — the Python server
# hosts the app, and the Vite dev server proxies /api to 127.0.0.1:8788).
# VITE_ANALYSIS_API=

# No Supabase variables are needed: this build uses the local JSON dataset
# configuration in public/data/manifest.json.

# Optional (client-side, build time): replace the built-in basemaps with one
# custom raster tile source (and its attribution HTML).  Without these the map
# offers two keyless basemaps: "Earth" (Esri World Imagery, default, dimmed
# for the dark theme) and "Reference" (Esri World Dark Gray plus labels).
# A custom source is shown as-is, so use tiles that are already dark, and
# make sure it sends CORS headers and does not require an API key.
# VITE_BASEMAP_URL=
# VITE_BASEMAP_ATTRIBUTION=
