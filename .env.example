# Server-side environment variables (Vercel project settings).
# The Gemini API key must stay server-side. Never use a VITE_ prefix for it.

# Required for the "Explain this change" feature.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-2.5-flash).
GEMINI_MODEL=

# No Supabase variables are needed: this build uses the local JSON dataset
# configuration in public/data/manifest.json.

# Optional (client-side, build time): replace the built-in basemaps with one
# custom raster tile source (and its attribution HTML).  Without these the map
# offers two keyless basemaps: "Earth" (Esri World Imagery, default, dimmed
# for the dark theme) and "Reference" (Esri World Dark Gray plus labels).
# A custom source is shown as-is, so use tiles that are already dark, and
# make sure it sends CORS headers and does not require an API key.
# VITE_BASEMAP_URL=
# VITE_BASEMAP_ATTRIBUTION=
