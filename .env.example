# Server-side environment variables (Vercel project settings).
# The Gemini API key must stay server-side. Never use a VITE_ prefix for it.

# Required for the "Explain this change" feature.
GEMINI_API_KEY=

# Optional: Gemini model id (default: gemini-2.5-flash).
GEMINI_MODEL=

# No Supabase variables are needed: this build uses the local JSON dataset
# configuration in public/data/manifest.json.
